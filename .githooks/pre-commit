#!/bin/sh
set -e

echo ""
echo "=== [PRE-COMMIT] Full Definition of Done gates ==="

# Format only staged files that actually differ from Prettier (0 disk writes when clean)
node scripts/format-changed.mjs --staged
npm run gate

# Re-stage generated model types only if schema changes updated them during gate
if ! git diff --quiet -- js/model.generated.ts; then
	git add -- js/model.generated.ts
fi

echo "=== [PRE-COMMIT] Passed! Verified staged changes without touching clean buffers. ==="
echo ""


