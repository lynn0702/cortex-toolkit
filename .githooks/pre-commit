#!/bin/sh
set -e

echo ""
echo "=== [PRE-COMMIT] Full Definition of Done gates ==="

# Check if staged files include source changes before the gate
HAS_SOURCE_CHANGES=0
if git diff --cached --name-only | grep -qE '^(js|css|schema|data)/'; then
	HAS_SOURCE_CHANGES=1
fi

npm run gate

# Re-stage formatted files safely (handling spaces, quotes, and non-ASCII characters)
git diff --cached --name-only -z --diff-filter=d | xargs -0 -r git add --

# If staged files include source changes, ensure build outputs stay in sync
if [ "$HAS_SOURCE_CHANGES" -eq 1 ]; then
	git add -- index.html js/app.min.js js/templates.bundle.js css/app.min.css 2>/dev/null || true
fi

echo "=== [PRE-COMMIT] Passed! ==="
echo ""


