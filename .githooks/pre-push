#!/bin/sh
set -e

echo ""
echo "=== [PRE-PUSH] Full Definition of Done gates ==="
npm run gate
if ! git diff --quiet -- js/model.generated.ts; then
	echo "[FAIL] Generated types changed during gate! Commit updated generated types before pushing."
	git status -s -- js/model.generated.ts
	exit 1
fi
echo "=== [PRE-PUSH] All gates passed! Proceeding with push. ==="
echo ""

