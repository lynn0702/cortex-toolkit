{
	"typescript.tsdk": "node_modules/typescript/lib",
	"typescript.enablePromptUseWorkspaceTsdk": true,
	"files.associations": {
		"*.scss": "scss"
	},
	"scss.validate": true,
	"editor.insertSpaces": false,
	"editor.formatOnSave": false,
	"files.eol": "\n",
	"files.insertFinalNewline": true,
	"json.schemas": [
		{
			"fileMatch": [
				"*.curio.json"
			],
			"url": "./schema/0.2/curiosity.schema.json"
		},
		{
			"fileMatch": [
				"*.template.layered.json"
			],
			"url": "./schema/0.2/sheet-template.schema.json"
		}
	]
}
