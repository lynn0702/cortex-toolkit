{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"types": [],
		"plugins": [
			{
				"name": "@vue/typescript-plugin",
				"location": "@vue/language-core",
				"languages": ["vue"]
			}
		]
	},
	"include": ["js/**/*.ts", "js/**/*.vue"]
}
